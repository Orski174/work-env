# Copy to .env and fill in. .env is gitignored.
# These default to sensible values in scripts/lib.sh if left blank.

# Root of this repo (auto-detected if empty)
WORK_ENV_ROOT=

# Where your other local git repos live (used for editable installs / references)
REPOS_ROOT=

# Optional override for data location (defaults to $WORK_ENV_ROOT/data)
DATA_ROOT=

# Optional override for outputs location (defaults to $WORK_ENV_ROOT/outputs)
OUTPUTS_ROOT=

# ---- Add task-specific variables below as needed ----
# EXAMPLE_API_KEY=
